# Good Dream Production Environment Variables & API Keys
# Gemini API Key: Configure application restrictions in Google Cloud Console
# (Android package name com.example / SHA-1 certificate fingerprint)
GEMINI_API_KEY=MY_GEMINI_API_KEY
RECAPTCHA_SITE_KEY=default_recaptcha_site_key

# Transactional Email Dispatch:
# In production, the client enqueues emails directly to Firestore's /mail queue
# (Firebase Trigger Email extension), so SMTP_PASSWORD is not required in client builds.
# For local offline debugging with Google SMTP, you may optionally provide:
SMTP_EMAIL=gooddreamshomedecor@gmail.com
SMTP_PASSWORD=

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_TfYEXhy3Yk78zc
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
PORT=3000
